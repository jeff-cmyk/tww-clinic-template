# Normalize line endings so commits made on Windows and macOS don't show up as
# whole-file diffs. Text files are stored as LF in the repo and checked out
# using each machine's native convention.
* text=auto eol=lf

# Binary assets — never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
