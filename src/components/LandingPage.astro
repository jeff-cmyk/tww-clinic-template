---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

interface Props {
  headline: string;
  subhead: string;
  offer?: string;
  title?: string;
  eyebrow?: string;
}

const clinics = await getCollection('clinic');
const clinic = clinics[0].data;

const { headline, subhead, offer, title, eyebrow = 'New Patients' } = Astro.props;

const scheduleUrl = clinic.scheduling.type === 'neo' && clinic.scheduling.neoUrl
  ? clinic.scheduling.neoUrl
  : 'tel:' + clinic.phone;
const telUrl = 'tel:' + clinic.phone;
---
<BaseLayout title={title ?? `New Patient | ${clinic.seo.title}`}>
  <main class="lp">

    <header class="lp-header">
      <div class="lp-header__inner">
        <img src="/images/tww-logo-white.png" alt={clinic.name} height="28" />
        <a href={telUrl} class="lp-header__phone">{clinic.phone}</a>
      </div>
    </header>

    <section class="lp-hero">
      <div class="lp-hero__inner">
        <p class="lp-eyebrow">{clinic.address.city}, {clinic.address.state} &nbsp;·&nbsp; {eyebrow}</p>
        <h1 class="lp-headline">{headline}</h1>
        <p class="lp-subhead">{subhead}</p>
        {offer && <p class="lp-offer">{offer}</p>}
        <a href={scheduleUrl} target="_blank" rel="noopener noreferrer" class="lp-btn">{clinic.scheduling.ctaText}</a>
        <p class="lp-fine">New patients only &nbsp;·&nbsp; {clinic.name}</p>
      </div>
    </section>

    <div class="lp-trust">
      <div class="lp-trust__inner">
        <div class="lp-trust__item"><span class="lp-check">✓</span>Advanced diagnostic testing</div>
        <div class="lp-trust__item"><span class="lp-check">✓</span>Personalized Health Restoration Plan</div>
        <div class="lp-trust__item"><span class="lp-check">✓</span>Root cause focus — not symptom management</div>
        <div class="lp-trust__item"><span class="lp-check">✓</span>66+ clinic national network</div>
      </div>
    </div>

    <section class="lp-steps">
      <div class="lp-steps__inner">
        <p class="lp-label">Your First Visit</p>
        <h2 class="lp-section-title">What to Expect</h2>
        <div class="lp-steps__grid">
          <div class="lp-step">
            <span class="lp-step__num">01</span>
            <h3 class="lp-step__title">Health History Review</h3>
            <p class="lp-step__body">We take time to understand your full story — not just your symptoms. Where you've been matters as much as where you are now.</p>
          </div>
          <div class="lp-step">
            <span class="lp-step__num">02</span>
            <h3 class="lp-step__title">Advanced Testing</h3>
            <p class="lp-step__body">We run the diagnostics that uncover what conventional medicine misses — the real root causes of your health challenges.</p>
          </div>
          <div class="lp-step">
            <span class="lp-step__num">03</span>
            <h3 class="lp-step__title">Your Restoration Plan</h3>
            <p class="lp-step__body">You leave with a clear personalized roadmap — not a script to mask symptoms, but a real path to total restoration.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="lp-cta">
      <div class="lp-cta__inner">
        <div>
          <p class="lp-label lp-label--light">Take the First Step</p>
          <h2 class="lp-cta__title">Ready for Real Answers?</h2>
          <p class="lp-cta__sub">Book your new patient visit at {clinic.name}. We'll find the missing piece.</p>
        </div>
        <div class="lp-cta__action">
          <a href={scheduleUrl} target="_blank" rel="noopener noreferrer" class="lp-btn lp-btn--white">{clinic.scheduling.ctaText}</a>
          <a href={telUrl} class="lp-cta__call">Or call us: {clinic.phone}</a>
        </div>
      </div>
    </section>

    <div class="lp-foot">
      <div class="lp-foot__inner">
        <span>{clinic.name} &nbsp;·&nbsp; {clinic.address.street}, {clinic.address.city}, {clinic.address.state} {clinic.address.zip}</span>
        <span><a href="/">Main site</a> &nbsp;·&nbsp; Part of <a href="https://thewellnessway.com" target="_blank" rel="noopener noreferrer">The Wellness Way</a></span>
      </div>
    </div>

  </main>
</BaseLayout>

<style>
  .lp {
    background: #ffffff;
    color: #1a1a1a;
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
  }

  /* ── Header ── */
  .lp-header {
    background: #162318;
    padding: 1.25rem 2rem;
  }
  .lp-header__inner {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .lp-header__phone {
    color: #fff;
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
  }
  .lp-header__phone:hover { color: #6DC135; }

  /* ── Hero ── */
  .lp-hero {
    padding: 6rem 2rem 5rem;
    background: #ffffff;
    border-bottom: 1px solid #ebebeb;
  }
  .lp-hero__inner {
    max-width: 660px;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }
  .lp-eyebrow {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #6DC135;
    margin: 0;
  }
  .lp-headline {
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 6vw, 4.25rem);
    line-height: 1.0;
    color: #1a1a1a;
    margin: 0;
  }
  .lp-subhead {
    font-size: 1rem;
    line-height: 1.7;
    color: #555;
    max-width: 50ch;
    margin: 0;
  }
  .lp-offer {
    display: inline-block;
    background: #f3f9ee;
    border: 1px solid #6DC135;
    color: #3f7a1f;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.75rem 1.5rem;
    margin: 0;
  }
  .lp-btn {
    display: inline-block;
    background: #6DC135;
    color: #fff;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 1rem 2.5rem;
    transition: background 0.2s;
    margin-top: 0.5rem;
  }
  .lp-btn:hover { background: #5aab29; }
  .lp-fine {
    font-size: 0.7rem;
    color: #bbb;
    margin: 0;
  }

  /* ── Trust bar ── */
  .lp-trust {
    background: #f6f6f4;
    border-bottom: 1px solid #ebebeb;
    padding: 1.25rem 2rem;
  }
  .lp-trust__inner {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    justify-content: center;
    gap: 2.5rem;
    flex-wrap: wrap;
  }
  .lp-trust__item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: #444;
  }
  .lp-check {
    color: #6DC135;
    font-weight: 700;
  }

  /* ── Steps ── */
  .lp-steps {
    background: #ffffff;
    padding: 5rem 2rem;
  }
  .lp-steps__inner {
    max-width: 1100px;
    margin: 0 auto;
  }
  .lp-label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #6DC135;
    display: block;
    margin-bottom: 0.5rem;
  }
  .lp-label--light { color: #6DC135; }
  .lp-section-title {
    font-family: var(--font-display);
    font-size: 2.5rem;
    color: #1a1a1a;
    margin: 0 0 2.5rem;
  }
  .lp-steps__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    border-top: 3px solid #6DC135;
  }
  .lp-step {
    padding: 2rem 2rem 2rem 0;
    padding-right: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    border-right: 1px solid #ebebeb;
  }
  .lp-step:last-child { border-right: none; padding-right: 0; }
  .lp-step:not(:first-child) { padding-left: 2.5rem; }
  .lp-step__num {
    font-family: var(--font-display);
    font-size: 2.5rem;
    color: #6DC135;
    line-height: 1;
    display: block;
    margin-top: 1.5rem;
  }
  .lp-step__title {
    font-family: var(--font-display);
    font-size: 1.4rem;
    color: #1a1a1a;
    margin: 0;
  }
  .lp-step__body {
    font-size: 0.875rem;
    color: #666;
    line-height: 1.7;
    margin: 0;
  }

  /* ── CTA ── */
  .lp-cta {
    background: #162318;
    padding: 5rem 2rem;
  }
  .lp-cta__inner {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }
  .lp-cta__title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    color: #fff;
    margin: 0.5rem 0 1rem;
    line-height: 1.05;
  }
  .lp-cta__sub {
    color: rgba(255,255,255,0.5);
    font-size: 0.95rem;
    margin: 0;
  }
  .lp-cta__action {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    align-items: flex-start;
  }
  .lp-btn--white {
    background: #fff;
    color: #162318;
  }
  .lp-btn--white:hover { background: #f0f0f0; }
  .lp-cta__call {
    font-size: 0.875rem;
    color: rgba(255,255,255,0.4);
    text-decoration: none;
    transition: color 0.2s;
  }
  .lp-cta__call:hover { color: #6DC135; }

  /* ── Footer ── */
  .lp-foot {
    background: #0e0e0e;
    padding: 1.25rem 2rem;
  }
  .lp-foot__inner {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.7rem;
    color: rgba(255,255,255,0.25);
  }
  .lp-foot__inner a {
    color: rgba(255,255,255,0.4);
    text-decoration: none;
  }
  .lp-foot__inner a:hover { color: #6DC135; }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .lp-steps__grid { grid-template-columns: 1fr; }
    .lp-step { border-right: none; border-bottom: 1px solid #ebebeb; padding: 2rem 0; }
    .lp-step:last-child { border-bottom: none; }
    .lp-step:not(:first-child) { padding-left: 0; }
    .lp-cta__inner { grid-template-columns: 1fr; gap: 2.5rem; }
    .lp-trust__inner { gap: 1rem; }
    .lp-foot__inner { flex-direction: column; }
  }
</style>
