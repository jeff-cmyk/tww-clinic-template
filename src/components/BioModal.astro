---
interface Props {
  name: string;
  role: string;
  bio: string;
  photo?: string;
}

const { name, role, bio, photo } = Astro.props;

// Same folded-YAML problem as RichText: paragraph breaks survive as single
// newlines and HTML would otherwise collapse them into spaces.
const paragraphs = bio
  .split(/\n+/)
  .map((p) => p.trim())
  .filter(Boolean);

const uid = `bio-${Math.random().toString(36).slice(2, 9)}`;
const teaser = paragraphs[0] ?? '';
// Only worth a modal if there is meaningfully more than the teaser shows.
const hasMore = paragraphs.length > 1 || teaser.length > 240;
---

<div class="bio">
  <p class="team-card__bio bio__teaser">{teaser}</p>

  {hasMore && (
    <button type="button" class="bio__open" data-bio-open={uid} hidden>
      Read full bio
    </button>
  )}

  {hasMore && (
    <dialog class="bio-dialog" id={uid} aria-labelledby={`${uid}-name`}>
      <div class="bio-dialog__panel">
        <header class="bio-dialog__header">
          {photo && <img class="bio-dialog__photo" src={photo} alt="" />}
          <div class="bio-dialog__ident">
            <h2 class="bio-dialog__name" id={`${uid}-name`}>{name}</h2>
            <p class="bio-dialog__role">{role}</p>
          </div>
          <button type="button" class="bio-dialog__close" data-bio-close aria-label={`Close ${name} biography`}>
            <span aria-hidden="true">&times;</span>
          </button>
        </header>

        <div class="bio-dialog__body">
          {paragraphs.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </dialog>
  )}
</div>

<style>
  .bio {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  /* Fixed teaser height keeps every card in the grid aligned regardless of
     how much the clinic wrote. */
  .bio__teaser {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin: 0;
  }

  .bio__open {
    margin-top: 0.85rem;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--green);
    border-bottom: 1px solid currentColor;
    padding-bottom: 2px;
    transition: color 0.2s ease;
  }

  .bio__open:hover { color: var(--green-dark); }
  .bio__open:focus-visible { outline: 2px solid var(--green); outline-offset: 3px; }

  /* ── Dialog ─────────────────────────────────────────────── */
  .bio-dialog {
    padding: 0;
    border: 0;
    background: transparent;
    max-width: min(46rem, calc(100vw - 2rem));
    max-height: min(85vh, 52rem);
    width: 100%;
    overflow: visible;
    color: var(--black);
  }

  .bio-dialog__panel {
    background: var(--white);
    max-height: min(85vh, 52rem);
    display: flex;
    flex-direction: column;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.28);
  }

  .bio-dialog__header {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1.25rem;
    padding: 1.5rem 1.75rem;
    border-bottom: 1px solid var(--border);
    /* Stays put while the bio scrolls underneath. */
    flex: none;
  }

  .bio-dialog__photo {
    width: 64px;
    height: 64px;
    object-fit: cover;
    flex: none;
  }

  .bio-dialog__ident { min-width: 0; }

  .bio-dialog__name {
    font-family: var(--font-display);
    font-size: 1.75rem;
    line-height: 1.05;
    color: var(--black);
    margin: 0;
  }

  .bio-dialog__role {
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--green);
    margin: 0.35rem 0 0;
  }

  .bio-dialog__close {
    width: 2.25rem;
    height: 2.25rem;
    display: grid;
    place-items: center;
    border: 1px solid var(--border);
    background: none;
    cursor: pointer;
    font-size: 1.5rem;
    line-height: 1;
    color: var(--gray);
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .bio-dialog__close:hover {
    background: var(--black);
    border-color: var(--black);
    color: var(--white);
  }

  .bio-dialog__close:focus-visible { outline: 2px solid var(--green); outline-offset: 2px; }

  .bio-dialog__body {
    padding: 1.75rem;
    overflow-y: auto;
    font-size: 0.95rem;
    line-height: 1.75;
    color: #444;
  }

  .bio-dialog__body p {
    margin: 0;
    max-width: 62ch;
  }

  .bio-dialog__body p + p { margin-top: 1em; }

  /* ── Transitions ────────────────────────────────────────── */
  /* allow-discrete lets display and overlay animate, so the dialog fades out
     instead of vanishing. Browsers without it simply snap, which is fine. */
  .bio-dialog {
    opacity: 0;
    transform: translateY(10px) scale(0.99);
    transition:
      opacity 0.24s ease,
      transform 0.24s ease,
      overlay 0.24s ease allow-discrete,
      display 0.24s ease allow-discrete;
  }

  .bio-dialog[open] {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  @starting-style {
    .bio-dialog[open] {
      opacity: 0;
      transform: translateY(10px) scale(0.99);
    }
  }

  .bio-dialog::backdrop {
    background: rgba(12, 12, 12, 0.55);
    opacity: 0;
    transition:
      opacity 0.24s ease,
      overlay 0.24s ease allow-discrete,
      display 0.24s ease allow-discrete;
  }

  .bio-dialog[open]::backdrop { opacity: 1; }

  @starting-style {
    .bio-dialog[open]::backdrop { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .bio-dialog,
    .bio-dialog::backdrop {
      transition: none;
    }
    .bio-dialog { transform: none; }
  }

  @media (max-width: 640px) {
    .bio-dialog__header { padding: 1.25rem; gap: 1rem; }
    .bio-dialog__photo { width: 48px; height: 48px; }
    .bio-dialog__name { font-size: 1.4rem; }
    .bio-dialog__body { padding: 1.25rem; }
  }
</style>

<script>
  function initBioModals() {
    // Native <dialog> carries the focus trap, Escape handling and top-layer
    // stacking, so there is no need to reimplement any of it.
    if (typeof HTMLDialogElement === 'undefined') return;

    document.querySelectorAll<HTMLButtonElement>('[data-bio-open]').forEach((btn) => {
      if (btn.dataset.bioReady) return;
      const dialog = document.getElementById(btn.dataset.bioOpen!) as HTMLDialogElement | null;
      if (!dialog || typeof dialog.showModal !== 'function') return;

      btn.dataset.bioReady = 'true';
      // Only reveal the trigger once we know the dialog will actually open.
      btn.hidden = false;

      let isOpen = false;

      const onOpened = () => {
        if (isOpen) return;
        isOpen = true;
        // showModal does not reliably stop the page behind from scrolling.
        document.body.style.overflow = 'hidden';
      };

      const onClosed = () => {
        if (!isOpen) return;
        isOpen = false;
        document.body.style.overflow = '';
        btn.focus();
      };

      const close = () => {
        if (dialog.open) dialog.close();
      };

      btn.addEventListener('click', () => {
        dialog.showModal();
        onOpened();
      });

      // Watching the open attribute rather than relying solely on the close
      // event: this catches every close path (Escape, close button, backdrop)
      // even where the event does not fire, so the page can never be left
      // with scrolling locked.
      new MutationObserver(() => {
        if (dialog.open) onOpened();
        else onClosed();
      }).observe(dialog, { attributes: true, attributeFilter: ['open'] });

      dialog.addEventListener('close', onClosed);

      // Clicks on the backdrop land on the dialog element itself.
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) close();
      });

      dialog.querySelectorAll('[data-bio-close]').forEach((el) => {
        el.addEventListener('click', close);
      });
    });
  }

  initBioModals();
  document.addEventListener('astro:page-load', initBioModals);
</script>
