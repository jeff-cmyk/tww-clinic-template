---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';

const clinics = await getCollection('clinic');
const clinic = clinics[0].data;

const days = [
  { key: 'monday',    label: 'Monday' },
  { key: 'tuesday',   label: 'Tuesday' },
  { key: 'wednesday', label: 'Wednesday' },
  { key: 'thursday',  label: 'Thursday' },
  { key: 'friday',    label: 'Friday' },
  { key: 'saturday',  label: 'Saturday' },
  { key: 'sunday',    label: 'Sunday' },
] as const;

const fullAddress = clinic.address.street + ', ' + clinic.address.city + ', ' + clinic.address.state + ' ' + clinic.address.zip;
const shortAddress = clinic.address.street + ', ' + clinic.address.city + ', ' + clinic.address.state;
const mapsDirectionsUrl = 'https://maps.google.com/?q=' + encodeURIComponent(shortAddress);
const mapsEmbedUrl = 'https://maps.google.com/maps?q=' + encodeURIComponent(fullAddress) + '&output=embed';
const telUrl = 'tel:' + clinic.phone;
const mailUrl = 'mailto:' + clinic.email;
const scheduleUrl = clinic.scheduling.type === 'neo' && clinic.scheduling.neoUrl
  ? clinic.scheduling.neoUrl
  : telUrl;
---

<BaseLayout title={clinic.seo.contactTitle ?? `Contact | ${clinic.seo.title}`}>
  <Nav />

  <main>

    <section class="page-header">
      <div class="container page-header__inner">
        <p class="label">Find Us</p>
        <h1 class="display-lg page-header__headline">
          Visit Us in<br/>
          <span class="green">{clinic.address.city}, {clinic.address.state}</span>
        </h1>
      </div>
    </section>

    <section class="section contact">
      <div class="container contact__grid">

        <div class="contact__info">

          <div class="info-block reveal">
            <p class="label info-block__label">Address</p>
            <p class="info-block__value">
              {clinic.address.street}<br/>
              {clinic.address.city}, {clinic.address.state} {clinic.address.zip}
            </p>
            <a href={mapsDirectionsUrl} target="_blank" rel="noopener noreferrer" class="info-block__link">
              Get Directions →
            </a>
          </div>

          <div class="info-block reveal reveal-delay-1">
            <p class="label info-block__label">Phone</p>
            <a href={telUrl} class="info-block__value info-block__value--link">
              {clinic.phone}
            </a>
          </div>

          <div class="info-block reveal reveal-delay-2">
            <p class="label info-block__label">Email</p>
            <a href={mailUrl} class="info-block__value info-block__value--link">
              {clinic.email}
            </a>
          </div>

          <div class="info-block reveal reveal-delay-3">
            <p class="label info-block__label">Hours</p>
            <table class="hours-table">
              <tbody>
                {days.map(({ key, label }) => (
                  <tr class={clinic.hours[key].toLowerCase() === 'closed' ? 'closed' : ''}>
                    <td class="hours-table__day">{label}</td>
                    <td class="hours-table__time">{clinic.hours[key]}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

        </div>

        <div class="contact__map reveal reveal-delay-1">
          <div class="map-wrapper">
            <iframe
              class="map-iframe"
              loading="lazy"
              allowfullscreen
              referrerpolicy="no-referrer-when-downgrade"
              src={mapsEmbedUrl}
              title="Clinic location map"
            ></iframe>
          </div>
          <a href={mapsDirectionsUrl} target="_blank" rel="noopener noreferrer" class="map-directions">
            Get Directions →
          </a>
        </div>

      </div>
    </section>

    <section class="section section--tint scheduling">
      <div class="container scheduling__inner">
        <div class="scheduling__content reveal">
          <p class="label">Ready to Begin?</p>
          <h2 class="display-md scheduling__headline">Book Your First Visit</h2>
          <p class="scheduling__sub">
            New patients start with a comprehensive consultation.
            We'll review your health history, run the right tests,
            and build a plan specific to you.
          </p>
        </div>
        <div class="scheduling__action reveal reveal-delay-1">
          <a href={scheduleUrl} target="_blank" rel="noopener noreferrer" class="btn btn--primary">
            {clinic.scheduling.ctaText}
          </a>
          <p class="scheduling__note">
            Questions first? Call us at <a href={telUrl}>{clinic.phone}</a>
          </p>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>

<style>
  .green { color: var(--green); }

  .page-header {
    background: var(--dark);
    color: var(--off-white);
    padding-block: 6rem 4rem;
    border-bottom: 1px solid rgba(255,255,255,0.08);
  }

  .page-header__inner {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .page-header__headline { color: var(--off-white); }

  .contact__grid {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 5rem;
    align-items: start;
  }

  .contact__info {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .info-block {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .info-block__label { margin-bottom: 0.25rem; }

  .info-block__value {
    font-size: 1rem;
    color: var(--black);
    line-height: 1.6;
    max-width: none;
  }

  .info-block__value--link {
    font-weight: 600;
    color: var(--black);
    transition: color 0.2s;
  }
  .info-block__value--link:hover { color: var(--green); }

  .info-block__link {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: var(--green);
    text-transform: uppercase;
    transition: opacity 0.2s;
  }
  .info-block__link:hover { opacity: 0.7; }

  .hours-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  .hours-table tr { border-bottom: 1px solid var(--border); }
  .hours-table tr:last-child { border-bottom: none; }
  .hours-table td { padding: 0.5rem 0; }

  .hours-table__day {
    color: #888;
    width: 7rem;
  }

  .hours-table__time {
    color: var(--black);
    font-weight: 500;
  }

  .hours-table tr.closed .hours-table__time { color: #bbb; }

  .map-wrapper {
    width: 100%;
    aspect-ratio: 4/3;
    overflow: hidden;
    border: 1px solid var(--border);
  }

  .map-iframe {
    width: 100%;
    height: 100%;
    border: none;
  }

  .map-directions {
    display: inline-block;
    margin-top: 0.75rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--green);
    transition: opacity 0.2s;
  }
  .map-directions:hover { opacity: 0.7; }

  .scheduling__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: center;
  }

  .scheduling__headline {
    color: var(--black);
    margin-block: 0.75rem;
  }

  .scheduling__sub {
    color: #555;
    font-size: 0.95rem;
  }

  .scheduling__action {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    align-items: flex-start;
  }

  .scheduling__note {
    font-size: 0.8rem;
    color: #888;
    max-width: none;
  }

  .scheduling__note a {
    color: var(--green);
    font-weight: 600;
  }

  @media (max-width: 900px) {
    .contact__grid { grid-template-columns: 1fr; gap: 3rem; }
    .scheduling__inner { grid-template-columns: 1fr; gap: 2.5rem; }
  }
</style>
